# ── Dev (Windows) — `npm run dev:setup` shu faylni `.env` sifatida o'zi yaratadi ──

# O'z bazamiz: faqat foydalanuvchilar va audit (dev Postgres, 5433-port).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/payments"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# `project` bazasi — FAQAT O'QISH. Dev'da haqiqiy bazaga ulanib bo'lmaydi, shuning
# uchun soxta nusxa ishlatiladi (`npm run dev:stub` — tuzilishi serverdagi bilan bir xil).
PROJECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/payments_project_stub"

# Birinchi super admin (`npm run db:seed`). Parol kamida 10 belgi.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
