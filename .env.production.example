# ── Production (Linux, Docker) — nusxalang: cp .env.production.example .env.production ──
# Batafsil: DEPLOY.md

# O'z bazamiz (foydalanuvchilar, audit) — host Postgres'dagi alohida `payments` bazasi.
# ⚠️ Konteyner ichida `localhost` — konteynerning O'ZI. Host Postgres'iga
#    `host.docker.internal` orqali ulaniladi (docker-compose.yml → extra_hosts).
DATABASE_URL="postgresql://payments:PAROL@host.docker.internal:5432/payments"

# openssl rand -base64 32
NEXTAUTH_SECRET=""
# Faqat domen, pathsiz, HTTPS
NEXTAUTH_URL="https://davijara.uz"

# `project` bazasi — FAQAT O'QISH (ilova har so'rovni READ ONLY tranzaksiyada bajaradi).
# Tavsiya: alohida `payments_ro` roli, faqat 3 ta obyektga SELECT (DEPLOY.md §2).
PROJECT_DATABASE_URL="postgresql://payments_ro:PAROL@host.docker.internal:5432/project"
# Yoki obyektlar ilovasidagi kabi alohida kalitlar (PROJECT_DATABASE_URL bo'lmasa yig'iladi):
# DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_NAME=project
# DB_USER=
# DB_PASSWORD=

# Bitta so'rovga ruxsat etilgan eng ko'p vaqt (ms). Oshsa so'rov bekor qilinadi.
PROJECT_QUERY_TIMEOUT_MS=60000
# Umumiy ko'rsatkichlar keshi (soniya).
CACHE_SECONDS=300
# Excel eksportining eng katta hajmi (qator).
EXPORT_MAX_ROWS=300000

# Birinchi super admin: docker compose --profile setup run --rm seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
